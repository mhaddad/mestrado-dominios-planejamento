estado 0

    0 $accept: . file $end

    '('  deslocar, e ir ao estado 1

    file                ir ao estado 2
    problem_definition  ir ao estado 3


estado 1

    3 problem_definition: '(' . DEFINE_TOK $@1 problem_name

    DEFINE_TOK  deslocar, e ir ao estado 4


estado 2

    0 $accept: file . $end

    $end  deslocar, e ir ao estado 5


estado 3

    1 file: problem_definition .

    $padrão  reduzir usando a regra 1 (file)


estado 4

    3 problem_definition: '(' DEFINE_TOK . $@1 problem_name

    $padrão  reduzir usando a regra 2 ($@1)

    $@1  ir ao estado 6


estado 5

    0 $accept: file $end .

    $padrão  aceitar



#!/local/bin/tclsh
#for AIPS-2000 planning competition
#deterministic version
#format: control-r.execute control-file dir-name prob1 ... probk, where there must be a domain.pddl
#under dir-name, and all problems are in this directory as well

set PL /h/29/fl/pl-3.2.9/src/pl
set BIN /h/29/fl/aips00/dist/bin
set GO1 create\_one\_domain(domain)
set GO2 {solvep(problem,0)}

set AIPS load\_files(\['strips.pl','[lindex $argv 0]'\],\[silent(true)\])
set D [lindex $argv 1]

exec $BIN/pddl2lower $D/domain.pddl domain
exec $PL -g $AIPS -t $GO1 2> message
#puts stdout  [exec $PL -g $AIPS -t $GO1 2> message | $BIN/pl2pddl]
#puts stdout ""

for {set i 2} {$i < $argc} { incr i 1} {
	exec $BIN/pddl2lower $D/[lindex $argv $i] problem
    catch {puts stdout [exec $PL -G0 -L0 -T0 -g $AIPS -t $GO2 2> message | $BIN/pl2pddl]}
#	puts stdout ""
}

